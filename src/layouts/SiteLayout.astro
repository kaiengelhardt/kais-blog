---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/space-grotesk';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'de';
  noindex?: boolean;
}

const { title, description, lang = 'en', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kai Engelhardt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" sizes="48x48" href="/kai-engelhardt-logo-favicon-16.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/kai-engelhardt-logo-favicon-32.png" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/kai-engelhardt-logo-favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/kai-engelhardt-logo-apple-touch-icon.png" />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
