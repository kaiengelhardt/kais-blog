{
  "name": "kais-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.16.0"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0 && npm run lint:css",
    "lint:css": "stylelint \"src/**/*.{css,astro}\" --max-warnings=0",
    "lint:staged": "lint-staged",
    "typecheck": "astro check",
    "test:hooks": "node scripts/check-hooks.mjs",
    "test:build": "npm run build && node scripts/check-build.mjs",
    "dev": "astro dev",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "build": "astro check && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
